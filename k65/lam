<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Phạm Quỳnh Lâm | Gia Sư Vật Lí Luyện Thi THPT</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-cream: #f6f1e1;
      --bg-card: #ffffff;
      --navy: #1c356b;
      --royal: #2d55a6;
      --royal-light: #e8eef9;
      --text-main: #1d2939;
      --text-muted: #4b5563;
      --border-soft: rgba(28, 53, 107, 0.12);
      --shadow-sm: 0 6px 20px rgba(28, 53, 107, 0.06);
      --shadow-md: 0 14px 36px rgba(28, 53, 107, 0.12);
      --radius-lg: 20px;
      --radius-md: 14px;
      --transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Be Vietnam Pro', -apple-system, BlinkMacSystemFont, sans-serif;
      background-color: var(--bg-cream);
      color: var(--text-main);
      line-height: 1.65;
      overflow-x: hidden;
      position: relative;
    }

    /* Họa tiết Vật lí nền */
    .physics-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
      opacity: 0.07;
    }

    .physics-symbol {
      position: absolute;
      font-weight: 800;
      color: var(--navy);
      user-select: none;
    }

    .sym-1 { top: 14%; left: 4%; font-size: 3.5rem; transform: rotate(-12deg); }
    .sym-2 { top: 42%; right: 4%; font-size: 4rem; transform: rotate(10deg); }
    .sym-3 { bottom: 18%; left: 6%; font-size: 2.5rem; }
    .sym-4 { bottom: 10%; right: 6%; font-size: 2.8rem; }

    .container {
      width: 100%;
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 24px;
      position: relative;
      z-index: 1;
    }

    /* Navbar */
    header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(246, 241, 225, 0.88);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-soft);
      transition: var(--transition);
    }

    header.scrolled {
      box-shadow: var(--shadow-sm);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 74px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: var(--navy);
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 38px;
      height: 38px;
      display: grid;
      place-items: center;
      background: var(--navy);
      color: #fff;
      border-radius: 10px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 28px;
      list-style: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--text-main);
      font-weight: 600;
      font-size: 0.95rem;
      transition: var(--transition);
      position: relative;
    }

    .nav-links a:hover {
      color: var(--royal);
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -4px;
      width: 0;
      height: 2px;
      background: var(--royal);
      transition: var(--transition);
    }

    .nav-links a:hover::after {
      width: 100%;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      cursor: pointer;
      border: none;
      transition: var(--transition);
      font-family: inherit;
    }

    .btn-primary {
      background: var(--navy);
      color: #fff;
      box-shadow: 0 8px 20px rgba(28, 53, 107, 0.22);
    }

    .btn-primary:hover {
      background: var(--royal);
      transform: translateY(-2px);
      box-shadow: 0 12px 24px rgba(45, 85, 166, 0.28);
    }

    .btn-outline {
      background: transparent;
      color: var(--navy);
      border: 2px solid var(--navy);
    }

    .btn-outline:hover {
      background: var(--navy);
      color: #fff;
      transform: translateY(-2px);
    }

    .menu-toggle {
      display: none;
      background: none;
      border: none;
      cursor: pointer;
      color: var(--navy);
      padding: 6px;
    }

    /* Hero Section */
    .hero {
      padding: 64px 0 56px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.25fr 0.9fr;
      gap: 48px;
      align-items: center;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--royal-light);
      color: var(--navy);
      font-weight: 700;
      font-size: 0.85rem;
      padding: 8px 16px;
      border-radius: 999px;
      margin-bottom: 18px;
      border: 1px solid rgba(45, 85, 166, 0.2);
    }

    .hero-badge span.dot {
      width: 8px;
      height: 8px;
      background: var(--royal);
      border-radius: 50%;
      animation: pulse 1.8s infinite;
    }

    @keyframes pulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.5; }
    }

    .hero h1 {
      font-size: clamp(2.2rem, 4.5vw, 3.35rem);
      font-weight: 800;
      color: var(--navy);
      line-height: 1.15;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }

    .hero-subtitle {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--royal);
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .hero-desc {
      font-size: 1.02rem;
      color: var(--text-muted);
      margin-bottom: 28px;
      max-width: 580px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-bottom: 28px;
    }

    .hero-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag-pill {
      background: var(--bg-card);
      border: 1px solid var(--border-soft);
      padding: 7px 14px;
      border-radius: 10px;
      font-size: 0.86rem;
      font-weight: 600;
      color: var(--navy);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      box-shadow: var(--shadow-sm);
    }

    /* Avatar Frame */
    .hero-visual {
      display: flex;
      justify-content: center;
      position: relative;
    }

    .avatar-wrapper {
      position: relative;
      width: 330px;
      height: 390px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .avatar-bg-shape {
      position: absolute;
      inset: 14px 0 0 18px;
      background: linear-gradient(135deg, var(--navy), var(--royal));
      border-radius: 28px;
      transform: rotate(3deg);
      opacity: 0.9;
    }

    .avatar-card {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 28px;
      overflow: hidden;
      border: 5px solid #fff;
      box-shadow: var(--shadow-md);
      background: #e5e7eb;
    }

    .avatar-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    .float-badge {
      position: absolute;
      background: #fff;
      padding: 10px 14px;
      border-radius: 14px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--border-soft);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--navy);
      z-index: 2;
      animation: floatY 4s ease-in-out infinite;
    }

    .float-badge.top-left {
      top: 18px;
      left: -26px;
    }

    .float-badge.bottom-right {
      bottom: 22px;
      right: -22px;
      animation-delay: 1.5s;
    }

    .float-icon {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: var(--royal-light);
      color: var(--royal);
      display: grid;
      place-items: center;
      font-weight: 800;
    }

    @keyframes floatY {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    /* Quick Stats */
    .stats-strip {
      margin: 12px 0 64px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      background: var(--navy);
      color: #fff;
      padding: 28px 32px;
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-md);
    }

    .stat-item {
      text-align: center;
      position: relative;
    }

    .stat-item:not(:last-child)::after {
      content: "";
      position: absolute;
      right: -9px;
      top: 15%;
      height: 70%;
      width: 1px;
      background: rgba(255, 255, 255, 0.18);
    }

    .stat-value {
      font-size: 1.85rem;
      font-weight: 800;
      line-height: 1.2;
      margin-bottom: 4px;
    }

    .stat-label {
      font-size: 0.86rem;
      color: rgba(255, 255, 255, 0.8);
      font-weight: 500;
    }

    /* Section Commons */
    section.section {
      padding: 64px 0;
    }

    .section-header {
      margin-bottom: 36px;
    }

    .section-kicker {
      display: inline-block;
      font-size: 0.82rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--royal);
      margin-bottom: 8px;
    }

    .section-title {
      font-size: clamp(1.65rem, 3vw, 2.2rem);
      font-weight: 800;
      color: var(--navy);
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .section-title::after {
      content: "";
      flex: 1;
      height: 2px;
      background: linear-gradient(90deg, var(--royal), transparent);
      opacity: 0.35;
    }

    /* Education & Achievements */
    .two-col-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
    }

    .card {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      padding: 32px;
      border: 1px solid var(--border-soft);
      box-shadow: var(--shadow-sm);
      transition: var(--transition);
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-md);
    }

    .card-head {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 22px;
    }

    .card-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      background: var(--royal-light);
      color: var(--navy);
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .card-head h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: var(--navy);
    }

    .edu-school {
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--text-main);
      margin-bottom: 4px;
    }

    .edu-major {
      color: var(--royal);
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 20px;
    }

    .gpa-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .gpa-item {
      background: var(--bg-cream);
      padding: 10px 14px;
      border-radius: 12px;
    }

    .gpa-top {
      display: flex;
      justify-content: space-between;
      font-weight: 700;
      font-size: 0.9rem;
      color: var(--navy);
      margin-bottom: 6px;
    }

    .gpa-bar {
      width: 100%;
      height: 8px;
      background: rgba(28, 53, 107, 0.12);
      border-radius: 999px;
      overflow: hidden;
    }

    .gpa-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--navy), var(--royal));
      border-radius: 999px;
      width: 0;
      transition: width 1.1s ease-out;
    }

    .achievement-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .achievement-item {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 14px;
      background: var(--bg-cream);
      border-radius: 14px;
      border-left: 4px solid var(--royal);
    }

    .achievement-item strong {
      display: block;
      color: var(--navy);
      font-size: 1rem;
      margin-bottom: 2px;
    }

    .achievement-item span {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    /* Teaching Method */
    .method-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }

    .method-card {
      background: var(--bg-card);
      border-radius: var(--radius-lg);
      padding: 28px;
      border: 1px solid var(--border-soft);
      box-shadow: var(--shadow-sm);
      display: flex;
      gap: 18px;
      align-items: flex-start;
      transition: var(--transition);
    }

    .method-card:hover {
      transform: translateY(-4px);
      border-color: rgba(45, 85, 166, 0.35);
      box-shadow: var(--shadow-md);
    }

    .method-num {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      background: var(--navy);
      color: #fff;
      font-weight: 800;
      font-size: 1.05rem;
      display: grid;
      place-items: center;
      flex-shrink: 0;
    }

    .method-card h4 {
      font-size: 1.08rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 6px;
    }

    .method-card p {
      font-size: 0.94rem;
      color: var(--text-muted);
    }

    /* Contact & Class Info */
    .contact-wrapper {
      background: var(--navy);
      color: #fff;
      border-radius: 26px;
      padding: 44px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      box-shadow: var(--shadow-md);
      position: relative;
      overflow: hidden;
    }

    .contact-wrapper::before {
      content: "v = λf";
      position: absolute;
      right: 28px;
      bottom: 18px;
      font-size: 4rem;
      font-weight: 800;
      opacity: 0.06;
      pointer-events: none;
    }

    .contact-info h3 {
      font-size: 1.8rem;
      font-weight: 800;
      margin-bottom: 12px;
    }

    .contact-info > p {
      color: rgba(255, 255, 255, 0.82);
      margin-bottom: 28px;
      font-size: 0.98rem;
    }

    .info-pills {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .info-pill {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.18);
      padding: 14px 16px;
      border-radius: 14px;
    }

    .info-pill small {
      display: block;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: rgba(255, 255, 255, 0.72);
      margin-bottom: 3px;
    }

    .info-pill strong {
      font-size: 1rem;
      font-weight: 700;
    }

    .contact-direct {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .contact-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      background: rgba(255, 255, 255, 0.08);
      padding: 12px 16px;
      border-radius: 12px;
    }

    .contact-row-left {
      display: flex;
      align-items: center;
      gap: 12px;
      font-weight: 600;
    }

    .copy-btn {
      background: #fff;
      color: var(--navy);
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      transition: var(--transition);
      font-family: inherit;
    }

    .copy-btn:hover {
      background: var(--bg-cream);
      transform: scale(1.03);
    }

    /* Quick Inquiry Form */
    .contact-form {
      background: #fff;
      color: var(--text-main);
      padding: 28px;
      border-radius: 18px;
    }

    .contact-form h4 {
      color: var(--navy);
      font-size: 1.15rem;
      font-weight: 800;
      margin-bottom: 16px;
    }

    .form-group {
      margin-bottom: 14px;
    }

    .form-group label {
      display: block;
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--navy);
      margin-bottom: 5px;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
      width: 100%;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1.5px solid #d1d5db;
      font-family: inherit;
      font-size: 0.94rem;
      transition: var(--transition);
      outline: none;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
      border-color: var(--royal);
      box-shadow: 0 0 0 3px rgba(45, 85, 166, 0.15);
    }

    .form-submit {
      width: 100%;
      margin-top: 6px;
    }

    /* Toast */
    .toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: var(--navy);
      color: #fff;
      padding: 14px 20px;
      border-radius: 12px;
      font-weight: 600;
      font-size: 0.92rem;
      box-shadow: var(--shadow-md);
      transform: translateY(100px);
      opacity: 0;
      transition: var(--transition);
      z-index: 999;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    /* Footer */
    footer {
      padding: 36px 0;
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      border-top: 1px solid var(--border-soft);
      margin-top: 40px;
    }

    /* Scroll Reveal */
    .reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* Responsive */
    @media (max-width: 920px) {
      .hero-grid,
      .two-col-grid,
      .method-grid,
      .contact-wrapper {
        grid-template-columns: 1fr;
      }

      .hero {
        padding: 40px 0;
      }

      .hero-visual {
        order: -1;
      }

      .avatar-wrapper {
        width: 270px;
        height: 320px;
      }

      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
      }

      .stat-item:nth-child(2)::after {
        display: none;
      }
    }

    @media (max-width: 680px) {
      .nav-links,
      .nav-cta {
        display: none;
      }

      .menu-toggle {
        display: block;
      }

      .mobile-menu {
        display: none;
        flex-direction: column;
        gap: 14px;
        padding: 18px 24px 24px;
        background: var(--bg-cream);
        border-bottom: 1px solid var(--border-soft);
      }

      .mobile-menu.open {
        display: flex;
      }

      .mobile-menu a {
        text-decoration: none;
        color: var(--navy);
        font-weight: 700;
        font-size: 1rem;
      }

      .contact-wrapper {
        padding: 26px 20px;
      }

      .info-pills {
        grid-template-columns: 1fr;
      }

      .float-badge.top-left {
        left: -10px;
      }

      .float-badge.bottom-right {
        right: -10px;
      }
    }
  </style>
</head>
<body>

  <!-- Họa tiết nền Vật lí -->
  <div class="physics-bg" aria-hidden="true">
    <span class="physics-symbol sym-1">Ω</span>
    <span class="physics-symbol sym-2">λ</span>
    <span class="physics-symbol sym-3">v = λf</span>
    <span class="physics-symbol sym-4">F = ma</span>
  </div>

  <!-- Navbar -->
  <header id="navbar">
    <div class="container nav-inner">
      <a href="#" class="brand">
        <span class="brand-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="2.2" fill="currentColor"/>
            <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(30 12 12)"/>
            <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(-30 12 12)"/>
            <ellipse cx="12" cy="12" rx="10" ry="4.2" transform="rotate(90 12 12)"/>
          </svg>
        </span>
        <span>PHẠM QUỲNH LÂM</span>
      </a>

      <ul class="nav-links">
        <li><a href="#gioi-thieu">Giới thiệu</a></li>
        <li><a href="#hoc-van">Học vấn & Thành tích</a></li>
        <li><a href="#phuong-phap">Phương pháp</a></li>
        <li><a href="#lien-he">Liên hệ</a></li>
      </ul>

      <a href="#lien-he" class="btn btn-primary nav-cta">Đăng ký học</a>

      <button class="menu-toggle" id="menuToggle" aria-label="Mở menu">
